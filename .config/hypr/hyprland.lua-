--font = "Noto Sans Mono 12"

-- Edit the Hyprland desktop file

--     /usr/share/wayland-sessions/hyprland.desktop

--

-- Change the Exec= line:

--

-- Exec=env WLR_NO_HARDWARE_CURSORS=1 Hyprland

--

-- Edit Hyprland config file

--

-- ~/.local/share/hyprland.conf

--

-- Scroll down to find the "Cursor" section and add:

--

-- cursor {

--     no_hardware_cursors = true

--     use_cpu_buffer = true

--}

--

-- Reinitialize input devices

--

-- rfkill

-- Autostart
hl.on("hyprland.start", function()
    hl.exec_cmd("kitty")
    hl.exec_cmd("nm-applet &")
    hl.exec_cmd("waybar & firefox")
    hl.exec_cmd("~/.config/hypr/scripts/startup")
    hl.exec_cmd("fcitx5 -d")
end)
