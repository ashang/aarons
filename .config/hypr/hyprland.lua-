-- -- Function keys --

hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("~/.config/hypr/scripts/brightness --inc"))

hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("~/.config/hypr/scripts/brightness --dec"))

hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("~/.config/hypr/scripts/volume --inc"))

hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("~/.config/hypr/scripts/volume --dec"))

hl.bind("XF86AudioMute", hl.dsp.exec_cmd("~/.config/hypr/scripts/volume --toggle"))

hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("~/.config/hypr/scripts/volume --toggle-mic"))

hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"))

hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"))

hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play"))

hl.bind("XF86AudioStop", hl.dsp.exec_cmd("playerctl pause"))

-- -- Screenshots --

hl.bind("Print", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot --now"))

hl.bind("ALT" .. " + " .. "Print", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot --in5"))

hl.bind("SHIFT" .. " + " .. "Print", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot --in10"))

hl.bind("CTRL" .. " + " .. "Print", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot --win"))

hl.bind("SUPER" .. " + " .. "Print", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot --area"))

-- Change Focus

hl.bind("SUPER" .. " + " .. "left", hl.dsp.focus({ direction = "left" }))

hl.bind("SUPER" .. " + " .. "right", hl.dsp.focus({ direction = "right" }))

hl.bind("SUPER" .. " + " .. "up", hl.dsp.focus({ direction = "up" }))

hl.bind("SUPER" .. " + " .. "down", hl.dsp.focus({ direction = "down" }))

