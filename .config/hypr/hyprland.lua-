-- See https://wiki.hyprland.org/Configuring/Monitors/

-- monitor = name, resolution, position, scale

-- 0 -> normal (no transforms)

-- 1 -> 90 degrees

-- 2 -> 180 degrees

-- 3 -> 270 degrees

-- 4 -> flipped

-- 5 -> flipped + 90 degrees

-- 6 -> flipped + 180 degrees

-- 7 -> flipped + 270 degrees

hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
    scale    = "auto",
})

--monitor = eDP-1,1920x1080@60,0x0,1

--monitor = eDP-1,addreserved,10,10,10,10

--monitor = DP-1,transform,3

--Monitor DP-1 (ID 0): 2560x1440@59.95100 at 0x0

--Monitor HDMI-A-2 (ID 1): 2560x1440@59.95100 at 4000x0

--Monitor DP-2 (ID 2): 2560x1440@60.00000 at 2560x0

--monitor = DP-1,transform,3

hl.monitor({
    output   = "DP-1",
    --mode     = "transform",
    --position = 1,
    scale    = 1,
})

hl.monitor({
    output   = "DP-2",
    --mode     = "transform",
    --position = 3,
    scale    = 1,
})

hl.monitor({
    output   = "HDMI-A-2",
    --mode     = "transform",
    --position = 3,
    scale    = 1,
})

