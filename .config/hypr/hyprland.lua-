-- -- Rofi --

-- bindr = SUPER, SUPER_L, exec, $rofi_launcher

hl.bind("SUPER" .. " + " .. "D", hl.dsp.exec_cmd("~/.config/hypr/scripts/rofi_launcher"))

hl.bind("SUPER" .. " + " .. "R", hl.dsp.exec_cmd("~/.config/hypr/scripts/rofi_runner"))

hl.bind("SUPER" .. " + " .. "M", hl.dsp.exec_cmd("~/.config/hypr/scripts/rofi_music"))

-- hl.bind("SUPER_SHIFT" .. " + " .. "N", hl.dsp.exec_cmd("~/.config/hypr/scripts/rofi_network"))

hl.bind("SUPER" .. " + " .. "X", hl.dsp.exec_cmd("~/.config/hypr/scripts/rofi_powermenu"))

hl.bind("SUPER" .. " + " .. "A", hl.dsp.exec_cmd("~/.config/hypr/scripts/rofi_screenshot"))

